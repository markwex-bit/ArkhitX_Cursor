# Backend
CORS_ORIGINS=http://localhost:3010
DATA_MODE=demo
# demo = stacked_costbooks_demo.parquet (fast)
# full = stacked_costbooks.parquet

# LLM — use "none" on work PC (no API keys required)
LLM_PROVIDER=none
# anthropic | azure_openai | openai | none

# Personal machine only (optional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Corporate Azure OpenAI (work PC — from IT)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_KEY=

# OpenAI-compatible gateway
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Frontend (vite)
VITE_API_URL=http://localhost:8010
