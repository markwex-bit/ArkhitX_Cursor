# Qlik to Power BI Migration Assessor — environment variables
# Copy to .env and fill in values.

ANTHROPIC_API_KEY=sk-ant-...

# ArkhitX Governance (Phase 3) — leave blank to run standalone
# Fill in after running: python projects/qlik-pbi-migration/scripts/01_register_project.py
ARKHITX_DATABASE_URL=
ARKHITX_NEO4J_URI=
ARKHITX_NEO4J_USER=neo4j
ARKHITX_NEO4J_PASSWORD=
ARKHITX_PROJECT_ID=

# ── Data source ──────────────────────────────────────────────────────────
# "sample" (default) reads samples/*.json, no live API calls.
# "live" calls the real Qlik Sense + Power BI admin APIs below.
# Full setup instructions: docs/LIVE-EXTRACTION-SETUP.md
DATA_SOURCE=sample

# Qlik Sense Enterprise (on-premises) — certificate-based auth
QLIK_SERVER_URL=
QLIK_CLIENT_CERT_PATH=/certs/client.pem
QLIK_CLIENT_KEY_PATH=/certs/client_key.pem
QLIK_ROOT_CA_PATH=/certs/root.pem
QLIK_USER_DIRECTORY=
QLIK_USER_ID=
QLIK_VIRTUAL_PROXY=

# Power BI — Azure AD service principal + Admin Scanner API
PBI_TENANT_ID=
PBI_CLIENT_ID=
PBI_CLIENT_SECRET=
PBI_WORKSPACE_IDS=
