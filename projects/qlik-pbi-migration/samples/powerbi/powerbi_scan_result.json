          "createdDate": "2022-07-01T00:00:00.000Z",
          "tables": [
            { "name": "SalesFact", "columns": [{ "name": "SaleID", "dataType": "Int64" }, { "name": "Date", "dataType": "DateTime" }, { "name": "Amount", "dataType": "Decimal" }, { "name": "RegionID", "dataType": "Int64" }, { "name": "RepID", "dataType": "Int64" }] },
            { "name": "CustomerDim", "columns": [{ "name": "CustomerID", "dataType": "Int64" }, { "name": "Name", "dataType": "String" }, { "name": "Region", "dataType": "String" }] },
            { "name": "RegionDim", "columns": [{ "name": "RegionID", "dataType": "Int64" }, { "name": "RegionName", "dataType": "String" }] }
          ],
          "measures": [
            { "name": "Total Revenue", "expression": "SUM(SalesFact[Amount])" },
            { "name": "YoY Growth %", "expression": "DIVIDE([Total Revenue] - [Total Revenue PY], [Total Revenue PY])" },
            { "name": "Units Sold", "expression": "COUNTROWS(SalesFact)" }
          ],
          "datasourceUsages": [
            { "datasourceType": "Sql", "connectionDetails": { "server": "sqlwh01.corp.local", "database": "SALESDW_PROD" } }
          ],
          "refreshSchedule": { "enabled": true, "days": ["Everyday"], "times": ["02:00"], "lastRefreshTime": "2026-09-08T02:10:00.000Z" },
          "endorsementDetails": { "endorsement": "Certified" },
          "sensitivityLabel": { "labelId": "lbl-internal", "displayName": "Internal" }
        },
