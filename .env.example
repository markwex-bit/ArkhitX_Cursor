# Required: Your Anthropic API key
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# PostgreSQL (defaults work with docker-compose)
DATABASE_URL=postgresql://user:password@localhost:5432/arkhitx

# Neo4j (defaults work with docker-compose)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Claude model configuration
CLAUDE_MODEL=claude-sonnet-4-20250514
CLAUDE_MAX_TOKENS=4096
CLAUDE_TEMPERATURE=0.3

# JWT
JWT_SECRET=change-me-in-production

# CORS (comma-separated, for local dev outside Docker)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Frontend proxy target (local dev only — Docker sets this in docker-compose.yml)
VITE_API_TARGET=http://localhost:8000

# Debug
DEBUG=false
